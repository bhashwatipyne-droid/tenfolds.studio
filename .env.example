# Public site URL (used for metadata / OpenGraph)
NEXT_PUBLIC_SITE_URL=https://tenfolds.studio
# Optional hero media. If neither is set, the built-in illustration is shown.
NEXT_PUBLIC_HERO_VIDEO=
NEXT_PUBLIC_HERO_IMAGE=
# Optional: POST every audit request to this webhook (n8n, Zapier, Slack, Apps Script…)
AUDIT_WEBHOOK_URL=
# Google Tag Manager container ID (defaults to the tenfolds container)
NEXT_PUBLIC_GTM_ID=GTM-NH4WML8D
